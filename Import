@Composable
fun RetrofilmApp() {
    val context = LocalContext.current
    var hasPermissions by remember {
        mutableStateOf(
            ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED &&
            ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
        )
    }

    val launcher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestMultiplePermissions()
    ) { perms ->
        hasPermissions = perms[Manifest.permission.CAMERA] == true &&
                perms[Manifest.permission.RECORD_AUDIO] == true
    }

    LaunchedEffect(Unit) {
        if (!hasPermissions) {
            launcher.launch(arrayOf(Manifest.permission.CAMERA, Manifest.permission.RECORD_AUDIO))
        }
    }

    if (hasPermissions) {
        CamcorderScreen()
    } else {
        Box(
            modifier = Modifier.fillMaxSize().background(Color(0xFF141416)),
            contentAlignment = Alignment.Center
        ) {
            Button(onClick = {
                launcher.launch(arrayOf(Manifest.permission.CAMERA, Manifest.permission.RECORD_AUDIO))
            }) {
                Text("Grant Camera & Mic Access for Retrofilm", fontFamily = FontFamily.Monospace)
            }
        }
    }
}

@Composable
fun CamcorderScreen() {
    val context = LocalContext.current
    val lifecycleOwner = LocalLifecycleOwner.current

    var isRecording by remember { mutableStateOf(false) }
    var isExporting by remember { mutableStateOf(false) }
    var tapeCounter by remember { mutableIntStateOf(0) }
    val recordedSegments = remember { mutableStateListOf<File>() }

    val controller = remember { CamcorderController(context, lifecycleOwner) }
    val stitcher = remember { CassetteStitcher(context) }

    LaunchedEffect(Unit) {
        controller.bindCamera()
    }

    LaunchedEffect(isRecording) {
        while (isRecording) {
            delay(1000L)
            tapeCounter++
        }
    }

    val triggerEject = {
        if (recordedSegments.isNotEmpty() && !isRecording && !isExporting) {
            isExporting = true
            val outFile = File(context.cacheDir, "Retrofilm_Master_${System.currentTimeMillis()}.mp4")
            stitcher.exportCassetteWithSplices(
                segmentFiles = recordedSegments.toList(),
                outputFile = outFile,
                onComplete = { finalFile ->
                    saveToGallery(context, finalFile)
                    recordedSegments.forEach { it.delete() }
                    recordedSegments.clear()
                    tapeCounter = 0
                    isExporting = false
                    Toast.makeText(context, "Tape Ejected & Saved to Google Photos!", Toast.LENGTH_LONG).show()
                },
                onError = { err ->
                    isExporting = false
                    Toast.makeText(context, "Stitch Error: ${err.message}", Toast.LENGTH_LONG).show()
                }
            )
        }
    }

    CamcorderFoldContainer(
        isRecording = isRecording,
        isExporting = isExporting,
        segmentCount = recordedSegments.size,
        tapeCounter = tapeCounter,
        onRecordToggle = { shouldRecord ->
            if (isExporting) return@CamcorderFoldContainer
            if (shouldRecord) {
                controller.startSegment { savedFile ->
                    recordedSegments.add(savedFile)
                }
                isRecording = true
            } else {
                controller.stopSegment()
                isRecording = false
            }
        },
        onEjectTape = triggerEject,
        onZoomChanged = { controller.setZoom(it) },
        cameraPreview = {
            AndroidView(factory = { controller.previewView }, modifier = Modifier.fillMaxSize())
        }
    )
}

@Composable
fun CamcorderFoldContainer(
    isRecording: Boolean,
    isExporting: Boolean,
    segmentCount: Int,
    tapeCounter: Int,
    onRecordToggle: (Boolean) -> Unit,
    onEjectTape: () -> Unit,
    onZoomChanged: (Float) -> Unit,
    cameraPreview: @Composable () -> Unit
) {
    val context = LocalContext.current
    var isTabletopMode by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        WindowInfoTracker.getOrCreate(context)
            .windowLayoutInfo(context as ComponentActivity)
            .collect { layoutInfo ->
                val fold = layoutInfo.displayFeatures.filterIsInstance<FoldingFeature>().firstOrNull()
                isTabletopMode = fold?.state == FoldingFeature.State.HALF_OPENED &&
                        fold.orientation == FoldingFeature.Orientation.HORIZONTAL
            }
    }

    Box(modifier = Modifier.fillMaxSize().background(Color(0xFF141416))) {
        if (isTabletopMode) {
            Column(modifier = Modifier.fillMaxSize()) {
                Box(modifier = Modifier.weight(1f).fillMaxWidth()) {
                    CrtViewfinderPanel(isRecording, isExporting, segmentCount, cameraPreview)
                }
                Spacer(modifier = Modifier.fillMaxWidth().height(8.dp).background(Color.Black))
                Box(modifier = Modifier.weight(1f).fillMaxWidth()) {
                    CamcorderDeckPanel(
                        isRecording = isRecording,
                        segmentCount = segmentCount,
                        tapeCounter = tapeCounter,
                        onRecordToggle = onRecordToggle,
                        onEjectTape = onEjectTape,
                        onZoomChanged = onZoomChanged
                    )
                }
            }
        } else {
            // Unfolded / Outer Screen Layout
            Column(modifier = Modifier.fillMaxSize()) {
                Box(modifier = Modifier.weight(1.3f).fillMaxWidth()) {
                    CrtViewfinderPanel(isRecording, isExporting, segmentCount, cameraPreview)
                }
                Box(modifier = Modifier.weight(0.7f).fillMaxWidth()) {
                    CamcorderDeckPanel(
                        isRecording = isRecording,
                        segmentCount = segmentCount,
                        tapeCounter = tapeCounter,
                        onRecordToggle = onRecordToggle,
                        onEjectTape = onEjectTape,
                        onZoomChanged = onZoomChanged
                    )
                }
            }
        }
    }
}

@Composable
fun CrtViewfinderPanel(
    isRecording: Boolean,
    isExporting: Boolean,
    segmentCount: Int,
    cameraPreview: @Composable () -> Unit
) {
    var currentTime by remember { mutableStateOf("") }
    LaunchedEffect(Unit) {
        val sdf = SimpleDateFormat("MMM dd yyyy\nhh:mm:ss a", Locale.US)
        while (true) {
            currentTime = sdf.format(Date()).uppercase()
            delay(1000L)
        }
    }

    val infiniteTransition = rememberInfiniteTransition(label = "blink")
    val recAlpha by infiniteTransition.animateFloat(
        initialValue = 1f, targetValue = 0f,
        animationSpec = infiniteRepeatable(tween(600, easing = LinearEasing), RepeatMode.Reverse),
        label = "recAlpha"
    )

    Box(modifier = Modifier.fillMaxSize().padding(12.dp), contentAlignment = Alignment.Center) {
        Box(
            modifier = Modifier
                .aspectRatio(4f / 3f)
                .clip(RoundedCornerShape(12.dp))
                .border(2.dp, Color(0xFF2C2C2E), RoundedCornerShape(12.dp))
                .background(Color.Black)
        ) {
            cameraPreview()

            Column(
                modifier = Modifier.fillMaxSize().padding(16.dp),
                verticalArrangement = Arrangement.SpaceBetween
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text("SP [CLIPS:$segmentCount]", color = Color(0xFFE2E2E2), fontFamily = FontFamily.Monospace, fontSize = 13.sp, fontWeight = FontWeight.Bold)

                    if (isExporting) {
                        Text("EJECTING TAPE...", color = Color(0xFF30D158), fontFamily = FontFamily.Monospace, fontSize = 14.sp, fontWeight = FontWeight.Black)
                    } else if (isRecording) {
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Box(modifier = Modifier.size(10.dp).background(Color.Red.copy(alpha = recAlpha), CircleShape))
                            Spacer(modifier = Modifier.width(6.dp))
                            Text("REC", color = Color.Red.copy(alpha = recAlpha), fontFamily = FontFamily.Monospace, fontSize = 14.sp, fontWeight = FontWeight.Black)
                        }
                    } else {
                        Text("STBY", color = Color(0xFFFFD60A), fontFamily = FontFamily.Monospace, fontSize = 14.sp, fontWeight = FontWeight.Bold)
                    }
                }

                Text(
                    text = currentTime,
                    color = Color(0xFFF3F3F3),
                    fontFamily = FontFamily.Monospace,
                    fontSize = 13.sp,
                    lineHeight = 16.sp,
                    fontWeight = FontWeight.Bold
                )
            }
        }
    }
}

