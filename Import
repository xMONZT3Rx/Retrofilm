class CamcorderController(private val context: Context, private val lifecycleOwner: LifecycleOwner) {
    private var camera: Camera? = null
    private var videoCapture: VideoCapture<Recorder>? = null
    private var activeRecording: Recording? = null

    val previewView = PreviewView(context).apply {
        scaleType = PreviewView.ScaleType.FILL_CENTER
        implementationMode = PreviewView.ImplementationMode.COMPATIBLE
    }

    fun bindCamera() {
        val future = ProcessCameraProvider.getInstance(context)
        future.addListener({
            val provider = future.get()
            val preview = Preview.Builder().build().also { it.setSurfaceProvider(previewView.surfaceProvider) }
            val recorder = Recorder.Builder()
                .setQualitySelector(QualitySelector.from(Quality.SD))
                .setTargetVideoEncodingBitRate(3_500_000)
                .build()
            videoCapture = VideoCapture.withOutput(recorder)
            try {
                provider.unbindAll()
                camera = provider.bindToLifecycle(lifecycleOwner, CameraSelector.DEFAULT_BACK_CAMERA, preview, videoCapture)
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }, ContextCompat.getMainExecutor(context))
    }

    fun setZoom(zoom: Float) {
        val norm = ((zoom - 1f) / 4f).coerceIn(0f, 1f)
        camera?.cameraControl?.setLinearZoom(norm)
    }

    @SuppressLint("MissingPermission")
    fun startSegment(onSaved: (File) -> Unit) {
        val capture = videoCapture ?: return
        val file = File(context.cacheDir, "seg_${System.currentTimeMillis()}.mp4")
        val opts = FileOutputOptions.Builder(file).build()
        activeRecording = capture.output
            .prepareRecording(context, opts)
            .withAudioEnabled()
            .start(ContextCompat.getMainExecutor(context)) { event ->
                if (event is VideoRecordEvent.Finalize && !event.hasError()) {
                    onSaved(file)
                }
            }
    }

    fun stopSegment() {
        activeRecording?.stop()
        activeRecording = null
    }
}

